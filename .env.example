# Database
DATABASE_URL="mysql://user:password@host:port/runacos"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Admin seed
ADMIN_EMAIL="admin@runacos.org"
ADMIN_PASSWORD="your-admin-password"

# Cloudflare R2 (file storage)
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your-r2-access-key-id"
# S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# S3_BUCKET="your-bucket-name"
# S3_PUBLIC_URL="https://your-custom-domain.com"  # or https://pub-<hash>.r2.dev

# Resend (transactional email)
RESEND_API_KEY="your-resend-api-key"

# Paystack (payment processing)
PAYSTACK_SECRET_KEY="your-paystack-secret"

# Brevo SMTP (bulk/newsletter emails)
BREVO_SMTP_LOGIN="your-brevo-smtp-login"
BREVO_SMTP_KEY="your-brevo-smtp-key"
